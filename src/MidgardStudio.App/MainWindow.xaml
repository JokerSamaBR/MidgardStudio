<ui:FluentWindow x:Class="MidgardStudio.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MidgardStudio.App.ViewModels"
                 xmlns:views="clr-namespace:MidgardStudio.App.Views"
                 xmlns:common="clr-namespace:MidgardStudio.App.Common"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                 Title="Midgard Studio — WYO Digital"
                 Icon="/Assets/logo.png"
                 Width="1100" Height="720"
                 MinWidth="900" MinHeight="600"
                 WindowState="Normal"
                 ResizeMode="CanResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!-- Editable database workspace -->
        <DataTemplate DataType="{x:Type vm:DbWorkspaceViewModel}">
            <views:DbWorkspaceView />
        </DataTemplate>

        <!-- GRF browser -->
        <DataTemplate DataType="{x:Type vm:GrfBrowserViewModel}">
            <views:GrfBrowserView />
        </DataTemplate>

        <!-- Client items editor -->
        <DataTemplate DataType="{x:Type vm:ClientItemsViewModel}">
            <views:ClientItemsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ClientSkillsViewModel}">
            <views:ClientSkillsView />
        </DataTemplate>

        <!-- Item combos editor -->
        <DataTemplate DataType="{x:Type vm:ComboEditorViewModel}">
            <views:ComboEditorView />
        </DataTemplate>

        <!-- Configuration wizard -->
        <DataTemplate DataType="{x:Type vm:ConfigurationWizardViewModel}">
            <views:ConfigurationWizardView />
        </DataTemplate>

        <!-- Onboarding tour (first run) -->
        <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
            <views:OnboardingView />
        </DataTemplate>

        <!-- Backup manager -->
        <DataTemplate DataType="{x:Type vm:BackupManagerViewModel}">
            <views:BackupManagerView />
        </DataTemplate>

        <!-- Item Forge -->
        <DataTemplate DataType="{x:Type vm:ForgeViewModel}">
            <views:ForgeView />
        </DataTemplate>

        <!-- Settings -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Map cache editor -->
        <DataTemplate DataType="{x:Type vm:MapCacheEditorViewModel}">
            <views:MapCacheEditorView />
        </DataTemplate>

        <!-- Cash shop manager -->
        <DataTemplate DataType="{x:Type vm:CashShopManagerViewModel}">
            <views:CashShopManagerView />
        </DataTemplate>

        <!-- Placeholder for sections whose editor lands in a later phase -->
        <DataTemplate DataType="{x:Type vm:DbSectionViewModel}">
            <ui:Card>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="52" HorizontalAlignment="Center" Opacity="0.55" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TitleScreen}"
                               HorizontalAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                    <Border Margin="0,16,0,0" Padding="10,6" CornerRadius="6" Background="#22000000"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FilePath}" Opacity="0.6" FontFamily="Consolas"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_45_64_69_74_6f_72_20_63_6f_6d_69_6e_67_20_6f_6e_6c_69_6e_65_20_69_6e_20_61_20_6c_61_74_65_72_20_70_68_61_73_65_2e}" Opacity="0.45"
                               HorizontalAlignment="Center" Margin="0,16,0,0" FontStyle="Italic" />
                </StackPanel>
            </ui:Card>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar provides the window chrome + caption buttons; its branding is drawn by the overlay
             below (Title="" so it shows no text/icon of its own). -->
        <ui:TitleBar Grid.Row="0" Title="" />

        <!-- Branding overlay (logo · title · version · update pill) drawn ON TOP of the title bar. The logo,
             title and version are hit-test-invisible so the window still drags when grabbed by them; only the
             pill takes clicks. (A clickable control inside ui:TitleBar.Header gets swallowed by WPF-UI's caption
             drag — see wiki/gotchas/wpf-mvvm.md — so it lives here instead.) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0">
            <Image Source="/Assets/logo.png" Width="20" Height="20" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock Text="Midgard Studio · WYO Digital" Margin="10,0,0,0" Foreground="#ECECF4" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="False" />
            <!-- Version pill (brand-violet tint to match the logo). -->
            <Border Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="8" Padding="7,1"
                    Background="#2A2140" BorderBrush="#4C3C72" BorderThickness="1" IsHitTestVisible="False">
                <TextBlock Text="{Binding AppVersion}" Foreground="#BBA9E6" FontSize="11" FontWeight="Medium" />
            </Border>

            <!-- Update pill — electric animated border; click for the new version + release link. The window's
                 WM_NCHITTEST hook (MainWindow.xaml.cs) returns HTCLIENT over this pill so the title-bar caption
                 doesn't swallow the click (WPF-UI's ClientAreaBorder ignores WindowChrome.IsHitTestVisibleInChrome). -->
            <!-- Brush + effect live on the ToggleButton itself (mutable, element-level) and the Loaded storyboard
                 animates THEM with no Storyboard.TargetName — a ControlTemplate EventTrigger can't resolve template
                 names (Freezable OR element), so we animate the styled element directly, like SectionEnter. -->
            <ToggleButton x:Name="UpdateToggle" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                          Focusable="False" BorderThickness="1.3" Background="#2E1D4A">
                <ToggleButton.BorderBrush>
                    <SolidColorBrush Color="#8A5CF0" />
                </ToggleButton.BorderBrush>
                <ToggleButton.Effect>
                    <DropShadowEffect Color="#9B7BE0" BlurRadius="8" ShadowDepth="0" Opacity="0.55" />
                </ToggleButton.Effect>
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border CornerRadius="9" Padding="9,2"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12" Foreground="#ECE3FF" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Loc_55_70_64_61_74_65_20_41_76_61_69_6c_61_62_6c_65}" Foreground="#F4EEFF" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <ColorAnimation Storyboard.TargetProperty="(Control.BorderBrush).(SolidColorBrush.Color)"
                                                        From="#6FD0FF" To="#D07BFF" Duration="0:0:1.1" />
                                        <ColorAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)"
                                                        From="#6FD0FF" To="#D07BFF" Duration="0:0:1.1" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                        From="6" To="17" Duration="0:0:1.1" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                        From="0.45" To="0.95" Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <!-- Click-through popup: the new version + a link to the release page. -->
            <Popup PlacementTarget="{Binding ElementName=UpdateToggle}" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6" HorizontalOffset="-4"
                   IsOpen="{Binding IsChecked, ElementName=UpdateToggle, Mode=TwoWay}">
                <Border Background="#1C1730" BorderBrush="#5A47A0" BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="10" MaxWidth="300">
                    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" Color="#000000" /></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Sparkle24" Foreground="#C9B6FF" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_55_70_64_61_74_65_20_61_76_61_69_6c_61_62_6c_65}" FontWeight="SemiBold" Foreground="#F2ECFF" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Foreground="#E8DEFF" FontSize="20" FontWeight="Bold" Text="{Binding LatestVersion}" />
                        <TextBlock Text="{Binding UpdateMessage}" Foreground="#B3A4DC" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{DynamicResource Loc_56_69_65_77_20_72_65_6c_65_61_73_65}" Appearance="Primary" Command="{Binding OpenUpdateCommand}" Click="OnUpdateActionClicked">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Open24" /></ui:Button.Icon>
                            </ui:Button>
                            <!-- Dismiss only closes this popup; it never hides the pill. -->
                            <ui:Button Content="{DynamicResource Loc_44_69_73_6d_69_73_73}" Margin="8,0,0,0" Click="OnUpdateActionClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- ===== Top menu bar (replaces the old top-right icon cluster) ===== -->
        <Border Grid.Row="1" Padding="6,1" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Menu VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="{DynamicResource Loc_5f_46_69_6c_65}">
                        <MenuItem Header="{DynamicResource Loc_5f_46_6f_72_67_65_20_6e_65_77_20_69_74_65_6d_2026}" Command="{Binding OpenForgeCommand}"
                                  ToolTip="Create a complete custom item (server + client + sprite) in one flow">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Add24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_5f_53_61_76_65}" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"
                                  ToolTip="Write pending changes (only modified files are rewritten)">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Save24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_52_65_76_65_61_6c_20_5f_69_6d_70_6f_72_74_20_66_6f_6c_64_65_72}" Command="{Binding RevealImportFolderCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Folder24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Loc_4f_70_65_6e_20_63_6c_69_65_6e_74_20_5f_6c_75_61_20_66_6f_6c_64_65_72}" Command="{Binding OpenLuaFolderCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Folder24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Loc_5f_52_65_6c_6f_61_64_20_44_61_74_61_62_61_73_65}" Command="{Binding ReloadDataCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_5f_50_72_6f_66_69_6c_65_73_20_26_20_63_6f_6e_66_69_67_75_72_61_74_69_6f_6e_2026}" InputGestureText="Ctrl+," Command="{Binding OpenWizardCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Settings24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Loc_53_5f_77_69_74_63_68_20_70_72_6f_66_69_6c_65}" ItemsSource="{Binding Profiles}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}" />
                                    <Setter Property="IsCheckable" Value="False" />
                                    <Setter Property="InputGestureText" Value="{Binding ModeText}" />
                                    <Setter Property="Command"
                                            Value="{Binding DataContext.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_53_65_5f_74_74_69_6e_67_73}" Command="{Binding OpenSettingsCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Settings24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_45_5f_78_69_74}" Command="{Binding ExitCommand}" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Loc_5f_45_64_69_74}">
                        <MenuItem Header="{DynamicResource Loc_5f_55_6e_64_6f}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowUndo24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Loc_5f_52_65_64_6f}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowRedo24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_5f_51_75_69_63_6b_20_6f_70_65_6e_2026}" InputGestureText="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Loc_5f_56_69_65_77}">
                        <MenuItem Header="{DynamicResource Loc_5f_47_6f_20_74_6f}">
                            <MenuItem Header="{DynamicResource Loc_53_65_72_76_65_72_20_49_74_65_6d_73}" Command="{Binding GoSectionCommand}" CommandParameter="items" />
                            <MenuItem Header="{DynamicResource Loc_43_6c_69_65_6e_74_20_49_74_65_6d_73}" Command="{Binding GoSectionCommand}" CommandParameter="client_items" />
                            <MenuItem Header="{DynamicResource Loc_4d_6f_62_73}" Command="{Binding GoSectionCommand}" CommandParameter="mobs" />
                            <MenuItem Header="{DynamicResource Loc_50_65_74_73}" Command="{Binding GoSectionCommand}" CommandParameter="pets" />
                            <MenuItem Header="{DynamicResource Loc_53_6b_69_6c_6c_73}" Command="{Binding GoSectionCommand}" CommandParameter="skills" />
                            <MenuItem Header="{DynamicResource Loc_49_74_65_6d_20_43_6f_6d_62_6f_73}" Command="{Binding GoSectionCommand}" CommandParameter="combos" />
                            <MenuItem Header="{DynamicResource Loc_49_74_65_6d_20_47_72_6f_75_70_73}" Command="{Binding GoSectionCommand}" CommandParameter="groups" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_5f_53_79_73_74_65_6d}">
                            <MenuItem Header="{DynamicResource Loc_52_65_6e_65_77_61_6c}" IsCheckable="False" Command="{Binding EnableRenewalCommand}"
                                      IsChecked="{Binding IsRenewal, Mode=OneWay}" />
                            <MenuItem Header="{DynamicResource Loc_50_72_65_2d_52_65_6e_65_77_61_6c}" IsCheckable="False" Command="{Binding EnablePreRenewalCommand}"
                                      IsChecked="{Binding IsRenewal, Converter={StaticResource InverseBool}, Mode=OneWay}" />
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Loc_5f_54_6f_6f_6c_73}">
                        <MenuItem Header="{DynamicResource Loc_5f_47_52_46_20_42_72_6f_77_73_65_72}" Command="{Binding GoSectionCommand}" CommandParameter="grf">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="FolderZip24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Loc_5f_56_61_6c_69_64_61_74_69_6f_6e}" Command="{Binding GoSectionCommand}" CommandParameter="validation">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Checkmark24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Loc_5f_4d_61_70_20_43_61_63_68_65_20_45_64_69_74_6f_72}" Command="{Binding OpenMapCacheEditorCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Map24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Loc_5f_43_61_73_68_20_53_68_6f_70_20_4d_61_6e_61_67_65_72}" Command="{Binding OpenCashShopManagerCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Cart24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_5f_42_61_63_6b_75_70_20_4d_61_6e_61_67_65_72}" Command="{Binding OpenBackupManagerCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Save24" /></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Loc_4c_61_6e_67_75_61_67_65}">
                        <MenuItem x:Name="EnglishLanguageMenu" Header="{DynamicResource Loc_45_6e_67_6c_69_73_68}" IsCheckable="True" Click="SelectEnglishLanguage" />
                        <MenuItem x:Name="PortugueseLanguageMenu" Header="{DynamicResource Loc_50_6f_72_74_75_67_75_ea_73_20_28_42_72_61_73_69_6c_29}" IsCheckable="True" Click="SelectPortugueseLanguage" />
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Loc_5f_48_65_6c_70}">
                        <MenuItem Header="{DynamicResource Loc_5f_43_68_65_63_6b_20_66_6f_72_20_55_70_64_61_74_65_73_2026}" Command="{Binding CheckForUpdatesCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Loc_5f_44_6f_63_75_6d_65_6e_74_61_74_69_6f_6e}" Command="{Binding OpenDocsCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Loc_5f_41_62_6f_75_74_20_57_59_4f_20_44_69_67_69_74_61_6c_20_45_64_69_74_69_6f_6e}" Command="{Binding AboutCommand}">
                            <MenuItem.Icon><Image Source="/Assets/logo.png" Width="16" Height="16" /></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                    <!-- Active profile chip (right after Help) -->
                    <Border Background="#18FFFFFF" CornerRadius="4" Padding="9,0" Height="26" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Person24" FontSize="13" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProfileName}" FontSize="12" VerticalAlignment="Center" Opacity="0.9"
                                       ToolTip="Active profile" />
                        </StackPanel>
                    </Border>

                    <!-- Save status chip: pulsing green (saved) / red (unsaved) dot + text -->
                    <Border Background="#18FFFFFF" CornerRadius="4" Padding="9,0" Height="26" Margin="6,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#4FD17A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                <Setter Property="Fill" Value="#E0584F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.9">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="No changes" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                <Setter Property="Text" Value="Unsaved changes" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Undo / redo arrows (right after the changes indicator); auto-grey via CanExecute -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ui:Button Appearance="Transparent" Padding="7,4" Margin="0,0,2,0"
                                   Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24" FontSize="16" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" Padding="7,4"
                                   Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowRedo24" FontSize="16" /></ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right: record actions for the active entry + Save -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ActiveWorkspace.Editor.HasRecord, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <ui:Button Content="YAML" Command="{Binding ActiveWorkspace.ShowYamlCommand}" Margin="0,0,6,0"
                                   ToolTip="Preview the YAML written to the import file" />
                        <ui:Button Content="{DynamicResource Loc_43_6f_70_79_20_74_6f_20_49_6d_70_6f_72_74_20_74_6f_20_65_64_69_74}" Appearance="Primary"
                                   Command="{Binding ActiveWorkspace.Editor.CreateOverrideCommand}"
                                   Visibility="{Binding ActiveWorkspace.Editor.IsEditable, Converter={StaticResource BoolToVis}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                        <Border Width="1" Height="18" Background="#22FFFFFF" Margin="8,0" />
                    </StackPanel>

                    <!-- Item Combos actions (only on that screen) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ActiveCombo, Converter={StaticResource NotNullToVis}, FallbackValue=Collapsed}">
                        <ui:Button Content="{DynamicResource Loc_43_6f_70_79_20_74_6f_20_49_6d_70_6f_72_74_20_74_6f_20_65_64_69_74}" Appearance="Primary" Margin="0,0,6,0"
                                   Command="{Binding ActiveCombo.CreateOverrideCommand}"
                                   Visibility="{Binding ActiveCombo.IsBaseSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                   ToolTip="Make this base combo editable (copy-on-write)" />
                        <ui:Button Content="{DynamicResource Loc_4e_65_77_20_63_6f_6d_62_6f}" Command="{Binding ActiveCombo.AddComboSetCommand}"
                                   ToolTip="Create a new custom combo">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                        </ui:Button>
                        <Border Width="1" Height="18" Background="#22FFFFFF" Margin="8,0" />
                    </StackPanel>

                    <!-- Save: black button; the border ring animates the logo gradient only when there's
                         something to save (enabled). Disabled = plain black. -->
                    <Button Command="{Binding SaveCommand}" Cursor="Hand"
                            ToolTip="Write pending changes (Ctrl+S) — only modified files are rewritten">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Ring" CornerRadius="8" Background="#000000" />
                                    <Border x:Name="Fill" CornerRadius="6" Margin="2" Background="#0C0C12" Padding="13,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Save24" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Loc_53_61_76_65}" Foreground="White" FontWeight="Medium" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter TargetName="Ring" Property="common:GradientBorder.Enabled" Value="True" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Fill" Property="Background" Value="#1A1A22" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Fill" Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- (The old update banner was replaced by the animated "Update Available" pill in the title-bar header.) -->

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Padding="8,4,8,8">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DbSectionViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="2,0,12,0" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <!-- Collapsible category groups (Server Databases / Client / Tools). Collapse state persists
                         for the session (the group containers aren't regenerated on selection). -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Margin" Value="0,2,0,4" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Padding="0">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                                                       VerticalAlignment="Center"
                                                                       TextOptions.TextFormattingMode="Display" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ItemCount}"
                                                                       FontSize="11" Opacity="0.35" Margin="6,0,4,0"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsPresenter Margin="0,2,0,2" />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Border>

            <!-- Content area (section breadcrumb + actions now live in the top bar) -->
            <ContentControl Grid.Column="1" Margin="12,6,16,16" Content="{Binding CurrentContent}" />
        </Grid>

        <!-- Command palette overlay (Ctrl+K / Ctrl+Shift+F) -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#CC0A0A0E"
                Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVis}}">
            <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}" />
            </Border.InputBindings>
            <ui:Card Width="660" MaxHeight="460" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0"
                     Background="#FF1E1E26" BorderBrush="#33FFFFFF" BorderThickness="1">
                <DockPanel>
                    <ui:TextBox x:Name="PaletteSearchBox" DockPanel.Dock="Top"
                                PlaceholderText="{DynamicResource Loc_53_65_61_72_63_68_20_61_6e_79_20_64_61_74_61_62_61_73_65_20_62_79_20_69_64_20_2f_20_61_65_67_69_73_20_2f_20_6e_61_6d_65_2026}"
                                Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <ListBox x:Name="PaletteResultsBox" ItemsSource="{Binding PaletteResults}" MaxHeight="380">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ActivatePaletteResultCommand}"
                                        CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteResultViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Background="#33FFFFFF" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Database}" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="{Binding Display}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ui:Card>
        </Border>

        <!-- Configuration wizard (first run / profile management) — gates the shell.
             Fully opaque so it stays readable over the Mica backdrop / desktop. -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="#FF14141A"
                Visibility="{Binding ShowWizard, Converter={StaticResource BoolToVis}}">
            <Border Margin="20" CornerRadius="10" Background="#FF1A1A22"
                    BorderBrush="#22FFFFFF" BorderThickness="1">
                <ContentControl Content="{Binding Wizard}" />
            </Border>
        </Border>

        <!-- Onboarding tour (first run only) — sits above the wizard/workspace until completed. -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="#FF08060F"
                Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}">
            <ContentControl Content="{Binding Onboarding}" />
        </Border>

        <!-- Click-spark overlay: sits above everything and never intercepts input -->
        <Canvas x:Name="SparkLayer" Grid.Row="0" Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</ui:FluentWindow>
