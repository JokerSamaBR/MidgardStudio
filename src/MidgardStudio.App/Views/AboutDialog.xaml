<ui:FluentWindow x:Class="MidgardStudio.App.Views.AboutDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Sobre Midgard Studio — WYO Digital"
                 Icon="/Assets/logo.png"
                 Width="480" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Sobre" />

        <StackPanel Grid.Row="1" Margin="24,8,24,22">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo.png" Width="56" Height="56" VerticalAlignment="Center" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Midgard Studio · WYO" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="WYO Digital Edition" Opacity="0.7" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="VersionText" Opacity="0.55" FontSize="12" Margin="0,14,0,0" />

            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20" Opacity="0.85"
                       Text="Edição WYO Digital para editar bancos de dados, itens, monstros, habilidades, grupos, loja e arquivos de cliente. Inclui visualizadores de GRF, sprites e ferramentas de validação. Compatível com bancos YAML no padrão rAthena." />

            <Border Margin="0,16,0,0" CornerRadius="6" Background="#1A4A8F3C" BorderBrush="#3A6FD08A"
                    BorderThickness="1" Padding="12,10">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                           Text="Os arquivos-base são lidos sem alterações. Personalizações ficam na camada import e nos arquivos de cliente personalizados, com cópias de segurança." />
            </Border>

            <TextBlock Margin="0,18,0,0" FontSize="13">
                <Run Text="Original: " /><Run Text="Kyoshio" FontWeight="SemiBold" /><Run Text=" · Edição: WYO Digital" />
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button x:Name="OkButton" Content="Fechar" Appearance="Primary" MinWidth="100" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
